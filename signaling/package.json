{
  "name": "umeet-signaling",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight WebRTC signaling server for UMeet 1-to-1 meetings",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "cors": "2.8.5",
    "socket.io": "4.7.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "eslint": "8.57.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
