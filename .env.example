# ---- Frontend (web) ----
# Public URL where the signaling server is reachable (Socket.IO).
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# Public URL of the deployed frontend (used for share links / metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: comma-separated STUN URLs (defaults to Google STUN if unset).
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional: a single TURN relay for restrictive networks. These values are
# public by nature of client-side WebRTC, so only use credentials you are
# comfortable exposing (e.g. short-lived or a free/self-hosted coturn).
# NEXT_PUBLIC_TURN_URL=turn:your-turn-host:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# ---- Signaling server ----
# Port the signaling server listens on.
PORT=4000

# Comma-separated list of allowed CORS origins. Use your deployed frontend URL
# in production. Leave unset to allow any origin (development only).
# CORS_ORIGIN=https://your-frontend.example.com
